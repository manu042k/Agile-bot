# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env.production for Azure deployment

# ============================================
# NEXTAUTH CONFIGURATION
# ============================================
# Production URL (your Azure Static Web App URL or custom domain)
NEXTAUTH_URL=https://agilebot-frontend.azurestaticapps.net

# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-strong-secret-key>

# Session configuration (in seconds)
NEXTAUTH_SESSION_MAX_AGE=43200    # 12 hours
NEXTAUTH_SESSION_UPDATE_AGE=3600  # 1 hour

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# ============================================
# BACKEND API CONFIGURATION
# ============================================
# Azure App Service URL
NEXT_PUBLIC_API_URL=https://agilebot-backend.azurewebsites.net

# WebSocket URL (wss:// for secure WebSocket)
NEXT_PUBLIC_WS_URL=wss://agilebot-backend.azurewebsites.net

# ============================================
# BUILD CONFIGURATION
# ============================================
# Set to 'true' for standalone build (Docker/Container)
BUILD_STANDALONE=false

# ============================================
# IMAGE OPTIMIZATION
# ============================================
# Comma-separated list of allowed image domains
NEXT_PUBLIC_IMAGE_DOMAINS=agilebotstore.blob.core.windows.net,cdn.jsdelivr.net

# Disable image optimization for static export
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=false

# ============================================
# ANALYTICS & MONITORING (Optional)
# ============================================
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_ERROR_TRACKING=true
