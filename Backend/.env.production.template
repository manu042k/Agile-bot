# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file and fill in actual values for Azure deployment
# Store sensitive values in Azure Key Vault

# ============================================
# DJANGO CORE SETTINGS
# ============================================
SECRET_KEY=<generate-strong-secret-key>
DEBUG=False
ALLOWED_HOSTS=agilebot-backend.azurewebsites.net,yourdomain.com

# ============================================
# DATABASE (PostgreSQL)
# ============================================
USE_POSTGRESQL=True
DB_NAME=agilebotdb
DB_USER=dbadmin
DB_PASSWORD=<your-secure-database-password>
DB_HOST=agilebot-db.postgres.database.azure.com
DB_PORT=5432
DB_SSLMODE=require

# ============================================
# REDIS (Celery + Channels + Cache)
# ============================================
REDIS_URI=rediss://:your-redis-key@agilebot-redis.redis.cache.windows.net:6380/0
USE_REDIS_CACHE=True

# ============================================
# AZURE BLOB STORAGE
# ============================================
USE_AZURE_STORAGE=True
AZURE_ACCOUNT_NAME=agilebotstore
AZURE_ACCOUNT_KEY=<your-storage-account-key>
AZURE_CONTAINER_NAME=media
AZURE_CUSTOM_DOMAIN=agilebotstore.blob.core.windows.net

# ============================================
# SECURITY SETTINGS
# ============================================
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
USE_X_FORWARDED_PROTO=True

# ============================================
# CSRF & CORS
# ============================================
CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_USE_SESSIONS=False
CSRF_TRUSTED_ORIGINS=https://agilebot-frontend.azurestaticapps.net,https://yourdomain.com

CORS_ORIGIN_ALLOW_ALL=False
CORS_ALLOW_CREDENTIALS=True
CORS_ALLOWED_ORIGINS=https://agilebot-frontend.azurestaticapps.net,https://yourdomain.com

# ============================================
# SESSION SETTINGS
# ============================================
SESSION_COOKIE_AGE=43200
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# X-FRAME OPTIONS
# ============================================
X_FRAME_OPTIONS=SAMEORIGIN

# ============================================
# JWT SETTINGS
# ============================================
ACCESS_TOKEN_LIFETIME=30
REFRESH_TOKEN_LIFETIME=1
ROTATE_REFRESH_TOKENS=True
BLACKLIST_AFTER_ROTATION=True

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=<your-email@example.com>
EMAIL_HOST_PASSWORD=<your-app-specific-password>
DEFAULT_FROM_EMAIL=<your-email@example.com>

# ============================================
# FRONTEND URL
# ============================================
FRONTEND_URL=https://agilebot-frontend.azurestaticapps.net

# ============================================
# GOOGLE OAUTH
# ============================================
GOOGLE_OAUTH_CLIENT_ID=<your-google-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=https://agilebot-backend.azurewebsites.net/api/accounts/auth/google/callback/

# ============================================
# AI API KEYS
# ============================================
COHERE_API_KEY=<your-cohere-api-key>
GROQ_API_KEY=<your-groq-api-key>

# ============================================
# CELERY SETTINGS
# ============================================
CELERY_TIMEZONE=UTC
CELERY_TASK_SCHEDULE_INTERVAL=3600

# ============================================
# LOGGING
# ============================================
DJANGO_LOG_LEVEL=INFO

# ============================================
# APPLICATION INSIGHTS (Optional)
# ============================================
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx;IngestionEndpoint=https://xxx
